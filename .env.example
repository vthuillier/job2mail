# Copiez ce fichier en .env puis renseignez vos propres clés.
# Toutes ces valeurs sont aussi modifiables depuis l'onglet "Réglages" de
# l'application une fois lancée (utile si vous ne voulez pas toucher de fichier).

# Clé API Sirene (INSEE) — https://api.insee.fr (portail développeur, API Sirene V3.11)
INSEE_TOKEN=

# Clé SerpAPI — https://serpapi.com (utilisée pour l'enrichissement web des entreprises)
SERPAPI_KEY=

# Clé Hunter.io — https://hunter.io (recherche d'emails de contact)
TOKEN_HUNTER_IO=

# Compte Gmail utilisé pour l'envoi des candidatures/relances.
# EMAIL_PASSWORD doit être un "mot de passe d'application" Gmail, pas votre mot
# de passe habituel : https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Ollama local (optionnel) — pour la génération d'accroches par LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b

# Clé de session Flask — une chaîne aléatoire longue, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Connexion "Se connecter avec Google" (OAuth) — console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Clé de chiffrement des refresh tokens Google stockés en base — ex:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
