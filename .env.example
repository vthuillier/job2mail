# Copiez ce fichier en .env puis renseignez vos propres clés.
#
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI et
# APP_ENCRYPTION_KEY sont opérateur-only (jamais exposées ni modifiables
# depuis l'onglet "Réglages" de l'application) et REQUISES — sans elles,
# l'application renvoie une erreur 500 au premier login Google OAuth ou à la
# première sauvegarde de clé API par un utilisateur. SECRET_KEY est aussi
# opérateur-only mais optionnelle (voir plus bas).
#
# SERPAPI_KEY et TOKEN_HUNTER_IO ci-dessous sont, elles, modifiables par
# chaque utilisateur depuis l'onglet "Réglages" — ne les définissez ici que
# pour fournir un override opérateur global (généralement pas souhaitable
# sur un déploiement multi-utilisateur).

# Clé API Sirene (INSEE) — https://api.insee.fr (portail développeur, API Sirene V3.11)
# Clé partagée, côté serveur uniquement — jamais lue depuis la config par
# utilisateur, jamais renvoyée au client.
INSEE_TOKEN=

# Clé SerpAPI — https://serpapi.com (utilisée pour l'enrichissement web des entreprises)
SERPAPI_KEY=

# Clé Hunter.io — https://hunter.io (recherche d'emails de contact)
TOKEN_HUNTER_IO=

# Boîte mail utilisée par la fonctionnalité de vérification des réponses par
# IMAP (/api/check-replies) — ACTUELLEMENT INERTE : il n'y a plus d'UI pour
# renseigner ces valeurs par utilisateur (l'envoi des candidatures se fait
# désormais via Gmail OAuth), et elles ne sont volontairement plus lues
# depuis ces variables d'environnement pour éviter qu'un opérateur les
# définissant ici pour son propre usage ne voie sa boîte mail lue pour
# n'importe quel utilisateur. Ne pas définir ces variables ici tant que
# cette fonctionnalité n'a pas été migrée en per-utilisateur.
# EMAIL_PASSWORD doit être un "mot de passe d'application" Gmail, pas votre mot
# de passe habituel : https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Envoi des emails transactionnels (lien magique de connexion).
# "log" (défaut) : logge sans envoyer — le lien complet n'apparaît qu'en
# FLASK_DEBUG=1. "smtp" : envoie via un compte SMTP dédié (indépendant des
# comptes Gmail utilisateur ci-dessus) — configurer les variables ci-dessous.
TRANSACTIONAL_EMAIL_PROVIDER=log
TRANSACTIONAL_SMTP_HOST=
TRANSACTIONAL_SMTP_PORT=587
TRANSACTIONAL_SMTP_USER=
TRANSACTIONAL_SMTP_PASSWORD=
# Optionnel : adresse "From" si différente de TRANSACTIONAL_SMTP_USER
TRANSACTIONAL_SMTP_FROM=
# Optionnel : "1" pour SSL implicite (port 465) au lieu de STARTTLS
TRANSACTIONAL_SMTP_SSL=0

# Ollama local (optionnel) — pour la génération d'accroches par LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b

# Clé de session Flask — optionnelle : si absente, une clé est générée et
# persistée en base au premier démarrage (partagée entre workers gunicorn).
# Définissez-la explicitement en prod pour un contrôle explicite. Ex:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Email promu automatiquement admin (accès /admin) à chaque connexion
# (magic link ou Google) — laisser vide si aucun admin n'est nécessaire.
ADMIN_EMAIL=

# Connexion "Se connecter avec Google" (OAuth, REQUIS dès le premier login) —
# console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Clé de chiffrement (REQUIS) des refresh tokens Google et des clés
# SERPAPI_KEY/TOKEN_HUNTER_IO stockées par utilisateur en base — ex:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
